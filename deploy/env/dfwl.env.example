# Copy to /etc/dfwl/dfwl.env; uncomment and fill every required line.
# This example is deliberately incomplete and cannot start unchanged.
# Never commit the filled file. Restrict it to the service account (mode 600).
SPRING_PROFILES_ACTIVE=prod
# FLEET_DB_URL=jdbc:mysql://127.0.0.1:3306/fleet_ops?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# FLEET_DB_USERNAME=<database-user>
# FLEET_DB_PASSWORD=<database-password>
FLEET_STORAGE_ROOT=/data/dfwl/files
FLEET_OCR_PROVIDER=TENCENT
# FLEET_OCR_TENCENT_SECRET_ID=<secret-id>
# FLEET_OCR_TENCENT_SECRET_KEY=<secret-key>
FLEET_OCR_TENCENT_REGION=ap-guangzhou
FLEET_SERVER_PORT=8080
