.mp-home { min-height: 100vh; box-sizing: border-box; padding: 24rpx 28rpx calc(50rpx + env(safe-area-inset-bottom)); background: var(--mp-page); }
.mp-home-heading { margin: 30rpx 0 18rpx; font-size: 37rpx; font-weight: 700; color: var(--mp-text); }
.mp-section-heading { margin: 36rpx 0 20rpx; font-size: 33rpx; font-weight: 700; color: var(--mp-text); }
.mp-todo { display: flex; justify-content: space-between; align-items: center; min-height: 90rpx; margin-top: 18rpx; padding: 0 22rpx; border-radius: 16rpx; background: var(--mp-warning-soft); color: var(--mp-warning); font-size: 29rpx; font-weight: 600; }
.mp-approval-work { padding: 28rpx; background: #fff; border: 1rpx solid #deebe6; border-radius: 20rpx; }
.mp-approval-work-heading { display: flex; justify-content: space-between; align-items: center; color: #18332e; font-size: 31rpx; font-weight: 700; }
.mp-approval-count { color: #147466; font-size: 28rpx; }
.mp-approval-empty, .mp-approval-error { margin-top: 20rpx; color: #526d65; font-size: 28rpx; line-height: 1.5; }
.mp-approval-error { color: #b2372e; }
.mp-approval-error button { display: inline-flex; margin-left: 16rpx; color: #147466; background: #e6f4ef; }
.mp-approval-row { display: flex; flex-direction: column; gap: 6rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e6eeeb; }
.mp-approval-name { color: #18332e; font-size: 30rpx; font-weight: 600; }
.mp-approval-meta { color: #526d65; font-size: 25rpx; }
.mp-approval-action { display: flex; align-items: center; justify-content: center; min-height: 86rpx; margin-top: 20rpx; color: #fff; background: #147466; border-radius: 12rpx; font-size: 29rpx; }
