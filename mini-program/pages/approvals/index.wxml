<view class="approval-page">
  <view class="approval-heading">审批中心</view>
  <view class="approval-tabs">
    <view wx:if="{{canMine}}" class="approval-tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我的申请</view>
    <view wx:if="{{canTodo}}" class="approval-tab {{tab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="switchTab">待我处理</view>
    <view wx:if="{{canHistory}}" class="approval-tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">已处理</view>
  </view>
  <button wx:if="{{canCreate && tab === 'mine'}}" class="approval-create" bindtap="create">发起费用审批</button>
  <feedback-state wx:if="{{loading}}" kind="loading" message="正在加载审批" />
  <feedback-state wx:elif="{{error}}" kind="error" message="{{error}}" bind:retry="loadApprovals" />
  <block wx:else>
    <feedback-state wx:if="{{approvals.length === 0}}" kind="empty" message="这里还没有审批记录" />
    <view wx:for="{{approvals}}" wx:key="id" class="approval-card" bindtap="open" data-id="{{item.id}}">
      <view class="approval-card-top"><text>{{item.typeLabel}}</text><text class="approval-status">{{item.statusLabel}}</text></view>
      <view class="approval-meta">{{item.currentNodeName || '等待查看'}} · {{item.createdAt}}</view>
      <view class="approval-arrow">查看详情 ›</view>
    </view>
  </block>
</view>
