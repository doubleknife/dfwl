@import "../../design/tokens.wxss";
.approval-page { min-height: 100vh; padding: 28rpx; background: #f4f8f7; color: #173b36; }
.page-title { font-size: 40rpx; font-weight: 700; margin: 18rpx 0 26rpx; }
.subtabs { display: flex; gap: 16rpx; margin-bottom: 26rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx 10rpx; border-radius: 16rpx; background: #e9f1ee; font-size: 29rpx; }
.tab.active { background: #d5eee6; color: #086e5e; font-weight: 700; }
.approval-card { background: #fff; border: 1rpx solid #e1eae6; border-radius: 20rpx; padding: 26rpx; margin-bottom: 18rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.name { font-size: 31rpx; font-weight: 650; }
.state { color: #087462; font-size: 27rpx; }
.muted { color: #536e67; font-size: 26rpx; margin-top: 12rpx; line-height: 1.5; }
.amount { font-weight: 700; font-size: 32rpx; }
.card-action { color: #087462; font-size: 27rpx; margin-top: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; margin: 28rpx 0 16rpx; }
.back { min-height: 88rpx; display: flex; align-items: center; color: #087462; font-size: 29rpx; }
.field-label { font-size: 28rpx; font-weight: 600; margin: 18rpx 0 10rpx; }
.field { box-sizing: border-box; width: 100%; min-height: 90rpx; padding: 20rpx; border: 1rpx solid #d2e0db; border-radius: 14rpx; font-size: 29rpx; }
.primary,.secondary,.more { min-height: 92rpx; line-height: 92rpx; border-radius: 16rpx; margin-top: 18rpx; font-size: 29rpx; }
.primary { background: #147769; color: #fff; }
.secondary,.more { background: #e5f2ee; color: #126e60; }
.feedback { padding: 32rpx; background: #fff; border-radius: 16rpx; color: #536e67; margin: 16rpx 0; }
.error { color: #b43d35; }
.evidence-image { width: 156rpx; height: 156rpx; border-radius: 12rpx; background: #eef4f1; }
