@import "../../design/tokens.wxss";
.approval-page { min-height: 100vh; background: #f4f8f7; color: #173b36; padding: 28rpx; }
.approval-heading { font-size: 38rpx; font-weight: 700; margin: 12rpx 0 26rpx; }
.approval-tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.approval-tab { flex: 1; min-height: 88rpx; display: flex; justify-content: center; align-items: center; background: #fff; border-radius: 16rpx; color: #59716b; font-size: 28rpx; }
.approval-tab.active { background: #e1f2ed; color: #126f62; font-weight: 700; }
.approval-create { background: #167568; color: #fff; border-radius: 18rpx; font-size: 31rpx; min-height: 92rpx; margin-bottom: 26rpx; }
.approval-card { background: #fff; border-radius: 22rpx; padding: 30rpx; margin-bottom: 18rpx; }
.approval-card-top { display: flex; justify-content: space-between; font-size: 31rpx; font-weight: 650; }
.approval-status { color: #167568; font-size: 27rpx; }
.approval-meta { color: #637b75; font-size: 25rpx; margin-top: 16rpx; }
.approval-arrow { color: #147568; font-size: 26rpx; text-align: right; margin-top: 18rpx; }
