<view class="page">
  <view class="panel">
    <picker mode="selector" range="{{statuses}}" bindchange="onStatus">
      <view class="row">
        <text>状态筛选</text>
        <text class="tag">{{status || '全部'}}</text>
      </view>
    </picker>
  </view>
  <view wx:for="{{records}}" wx:key="id" class="panel" bindtap="open" data-id="{{item.id}}">
    <view class="row">
      <view class="title">{{item.routeNo}}</view>
      <view class="tag">{{item.status}}</view>
    </view>
    <view class="muted">{{item.businessDate}} · {{item.loadingPlace}} → {{item.unloadingPlace}}</view>
    <view class="muted">净重 {{item.netWeight || '-'}} · 达标 {{item.loadStandardMet === true ? '是' : (item.loadStandardMet === false ? '否' : '-')}}</view>
  </view>
  <view wx:if="{{records.length === 0}}" class="panel muted">暂无线路</view>
</view>
