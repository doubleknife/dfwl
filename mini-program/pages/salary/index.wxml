<view class="page">
  <view class="panel">
    <view class="title">我的工资单</view>
    <picker mode="date" fields="month" bindchange="onMonth">
      <view class="row">
        <text>月份</text>
        <text class="tag">{{businessMonth || '全部'}}</text>
      </view>
    </picker>
    <view class="row">
      <text>合计</text>
      <text class="tag">{{total}}</text>
    </view>
  </view>
  <view wx:for="{{records}}" wx:key="id" class="panel">
    <view class="row">
      <view>{{item.routeNo || item.routeId}}</view>
      <view class="tag">{{item.salaryAmount}}</view>
    </view>
    <view class="muted">{{item.businessMonth}} · {{item.businessDate}}</view>
  </view>
  <view wx:if="{{records.length === 0}}" class="panel muted">暂无工资数据</view>
</view>
