<view class="page">
  <view class="panel">
    <view class="title">车队小程序登录</view>
    <view class="field">
      <text class="label">手机号</text>
      <input value="{{phone}}" bindinput="onPhone" type="number" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input value="{{password}}" bindinput="onPassword" password />
    </view>
    <button class="primary" loading="{{loading}}" bindtap="login">登录</button>
  </view>
</view>
