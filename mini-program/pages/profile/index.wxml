<view class="profile-page">
  <view class="profile-heading">个人信息</view>
  <feedback-state wx:if="{{loadingProfile}}" kind="loading" message="正在加载个人信息" />
  <feedback-state wx:elif="{{error}}" kind="error" message="{{error}}" bind:retry="load" />
  <block wx:else>
    <view class="profile-card">
      <view class="profile-identity"><view class="profile-avatar">{{initial}}</view>
        <view><view class="profile-name">{{user.name || user.phone}}</view><view class="profile-role">{{driverTypeLabel}}</view></view></view>
      <view class="profile-fact"><text>手机号</text><text>{{user.phone}}</text></view>
      <view class="profile-fact"><text>当前车辆</text><text>{{bindingLabel}}</text></view>
      <view class="profile-fact"><text>角色</text><text>{{roleName}}</text></view>
    </view>
    <view class="profile-card">
      <view class="profile-security-heading">账户与安全</view>
      <view class="profile-security-link mp-detail-link" role="button" tabindex="0" bindtap="openChangePassword">修改密码 <text>›</text></view>
    </view>
    <button class="profile-logout mp-danger" bindtap="logout">退出登录</button>
  </block>
</view>
