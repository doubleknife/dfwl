<view class="page">
  <view class="panel">
    <view class="title">{{driver.name || user.phone}}</view>
    <view class="muted">{{user.role.name || user.roleCode}}</view>
    <view class="muted">手机号 {{driver.phone || user.phone}}</view>
    <view class="muted">司机类型 {{driver.driverType || '-'}}</view>
    <view class="muted">当前车辆 {{vehicle.plateNo || driver.currentVehicleId || '-'}}</view>
  </view>
  <view class="panel">
    <view class="title">修改密码</view>
    <view class="field">
      <text class="label">原密码</text>
      <input value="{{oldPassword}}" bindinput="onOld" password />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input value="{{newPassword}}" bindinput="onNew" password />
    </view>
    <button class="primary" loading="{{loading}}" bindtap="changePassword">保存</button>
  </view>
  <button class="danger" bindtap="logout">退出登录</button>
</view>
