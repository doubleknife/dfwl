@import "../../design/tokens.wxss";
.notice-page { min-height: 100vh; padding: 28rpx; background: #f4f8f7; color: #173b36; }
.notice-head { display: flex; justify-content: space-between; align-items: center; font-size: 38rpx; font-weight: 700; margin: 12rpx 0 28rpx; }
.notice-read { font-size: 26rpx; font-weight: 500; color: #14796b; padding: 12rpx; }
.notice-item { padding: 30rpx; border-radius: 22rpx; background: #fff; margin-bottom: 18rpx; min-height: 96rpx; }
.notice-title { display: flex; align-items: center; font-size: 31rpx; font-weight: 650; }
.notice-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d46b4c; margin-right: 12rpx; }
.notice-arrow { margin-left: auto; font-size: 36rpx; color: #81938f; }
.notice-summary { font-size: 27rpx; color: #526d67; margin-top: 12rpx; }
.notice-time { font-size: 24rpx; color: #70837e; margin-top: 16rpx; }
.notice-more { min-height: 88rpx; background: #e4f3ee; color: #126f62; border-radius: 18rpx; }
