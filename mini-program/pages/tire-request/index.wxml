<view class="tire-page">
  <view class="title">换胎申请</view>
  <view class="intro">拍照识别胎号，核对库存后提交审批。</view>
  <view wx:if="{{error}}" class="feedback error">{{error}} <text wx:if="{{stage==='PHOTO'}}" bindtap="load">重试</text></view>
  <view wx:if="{{loading}}" class="feedback">正在读取本人车辆与审批流程…</view>
  <view wx:if="{{denied}}" class="card">当前账号不能发起换胎申请。</view>
  <block wx:elif="{{!loading}}">
    <view class="steps">拍照 → 确认胎号 → 匹配库存 → 提交审批</view>
    <view wx:if="{{stage==='PHOTO' || stage==='CONFIRM'}}" class="card">
      <view class="heading">1. 拍摄轮胎胎号</view>
      <view class="hint">请让胎号完整入镜，光线不足时可重新拍摄。</view>
      <image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFill" bindtap="previewPhoto" />
      <button class="secondary" disabled="{{busy}}" bindtap="takePhoto">{{busy?'上传识别中…':photoPath?'重新拍摄':'拍照或选择照片'}}</button>
      <view wx:if="{{stage==='CONFIRM'}}">
        <view class="label">识别结果</view><view class="readonly">{{recognizedText || '暂无识别结果'}}</view>
        <view class="hint">{{ocrHint}}</view>
        <view class="label">确认胎号</view>
        <input class="field" value="{{confirmedTireNo}}" placeholder="照着图片核对胎号" bindinput="onTireNo" />
        <button class="primary" disabled="{{busy || !confirmedTireNo}}" bindtap="confirmNumber">{{busy?'匹配库存中…':'确认胎号并匹配库存'}}</button>
      </view>
    </view>
    <view wx:if="{{stage==='FORM' || stage==='REVIEW'}}" class="card">
      <view class="heading">2. 核对申请</view>
      <view class="label">申请司机</view><view class="readonly">{{driverName}}</view>
      <view class="label">当前公司车牌</view><view class="readonly">{{plateNo}}</view>
      <view class="label">匹配到的可用胎号</view><view class="readonly">{{confirmedTireNo}}</view>
      <view wx:if="{{stage==='FORM'}}">
        <view class="label">换胎审批流程</view>
        <picker mode="selector" range="{{templates}}" range-key="name" bindchange="onTemplate">
          <view class="field">{{templateIndex>=0?templates[templateIndex].name:'请选择流程'}}</view>
        </picker>
        <button class="primary" bindtap="review">核对并继续</button>
      </view>
      <view wx:else>
        <view class="hint">提交后进入审批；审批通过前不改变轮胎正式状态，待审期间不可重复申领。</view>
        <button class="secondary" disabled="{{busy}}" bindtap="backForm">返回修改</button>
        <button class="primary" disabled="{{busy}}" bindtap="submit">{{busy?'正在提交…':'确认提交换胎申请'}}</button>
      </view>
    </view>
    <view wx:if="{{stage==='DONE'}}" class="card">
      <view class="heading">申请已提交</view>
      <view class="hint">请到审批中心查看处理进度；轮胎将在审批通过后正式生效。</view>
      <navigator class="primary link" url="/pages/approvals/index">查看审批中心</navigator>
    </view>
  </block>
</view>
