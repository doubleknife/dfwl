<view class="tire-page">
  <view class="title">{{resubmitId?'修改换胎申请':'换胎申请'}}</view>
  <view class="intro">{{resubmitId?'请为每个胎号重新上传照片，核对胎号并校验库存后重新提交原审批。':'选择审批流程，逐张识别轮胎照片，全部通过库存校验后提交。'}}</view>
  <view wx:if="{{error}}" class="feedback error">{{error}}</view>
  <view wx:if="{{loading}}" class="feedback">正在读取本人车辆与审批流程…</view>
  <view wx:if="{{denied}}" class="card">当前账号不能发起换胎申请。</view>
  <block wx:else>
    <block wx:if="{{!loading}}">
    <view class="steps">{{resubmitId?'重新上传照片 → 校验库存 → 重新提交':'选择流程 → 上传照片并确认胎号 → 校验库存 → 提交审批'}}</view>
    <view wx:if="{{stage==='FLOW'}}" class="card">
      <view class="heading">1. 选择换胎审批流程</view>
      <view class="label">申请司机</view><view class="readonly">{{driverName}}</view>
      <view class="label">当前公司车牌</view><view class="readonly">{{plateNo}}</view>
      <view class="label">换胎审批流程</view>
      <search-select title="选择换胎审批流程" options="{{templates}}" label-key="name" value-key="id"
        current-value="{{templateIndex>=0?templates[templateIndex].id:''}}"
        display-text="{{templateIndex>=0?templates[templateIndex].name:''}}"
        placeholder="请选择流程" bind:change="onTemplate" />
      <button class="primary" disabled="{{templateIndex===-1}}" bindtap="continueToPhotos">下一步：上传照片</button>
      <button class="secondary" bindtap="cancel">取消</button>
    </view>
    <view wx:if="{{stage==='ITEMS'}}" class="card">
      <view class="heading">2. 识别与核对胎号</view>
      <view class="hint">{{resubmitId?'原照片仅供对照，每条保留的胎号都必须重新上传照片；也可删除后新增，最多 20 张。':'每张照片对应一个胎号。可修改、删除或重新上传，最多 20 张。'}}</view>
      <view wx:for="{{items}}" wx:key="ocrRecordId" class="tire-item">
        <view class="item-title">第 {{index+1}} 条 <text class="{{item.valid?'valid':'invalid'}}">{{item.message}}</text></view>
        <image class="photo" src="{{item.photoPath}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" />
        <view class="label">确认胎号</view>
        <input class="field" value="{{item.confirmedTireNo}}" maxlength="128" data-index="{{index}}" bindinput="onItemNumber" />
        <view class="item-actions">
          <button class="secondary" disabled="{{busy}}" data-index="{{index}}" bindtap="takePhoto">重新上传</button>
          <button class="mp-danger" disabled="{{busy}}" data-index="{{index}}" bindtap="removeItem">删除</button>
        </view>
      </view>
      <button class="secondary" disabled="{{busy || items.length>=20}}" bindtap="takePhoto">{{busy?'识别中…':'继续上传照片'}}</button>
      <view class="footer-actions">
        <button class="secondary" disabled="{{busy}}" bindtap="cancel">取消</button>
        <button class="primary" disabled="{{busy || !items.length}}" bindtap="submit">{{busy?'校验并提交中…':resubmitId?'重新提交审批':'提交换胎审批'}}</button>
      </view>
    </view>
    <view wx:if="{{stage==='DONE'}}" class="card">
      <view class="heading">{{resubmitId?'申请已重新提交':'申请已提交'}}</view>
      <view class="hint">本次 {{items.length}} 个胎号已进入同一审批流程；审批通过后统一生效。</view>
      <navigator class="mp-detail-button link" url="/pages/approvals/index">查看审批中心 ›</navigator>
    </view>
    </block>
  </block>
  <view wx:if="{{candidatePickerOpen}}" class="candidate-overlay">
    <view class="candidate-dialog">
      <view class="heading">选择照片中的胎号</view>
      <view class="hint">请对照照片上的标签。候选结果可能包含规格、日期，可在下方手动修改。</view>
      <scroll-view wx:if="{{candidateOptions.length}}" class="candidate-list" scroll-y="true">
        <view wx:for="{{candidateOptions}}" wx:key="candidate" data-index="{{index}}" bindtap="chooseCandidate"
          class="candidate-option {{candidateDraft===item.candidate?'selected':''}}">
          <text>{{item.candidate}}</text><text wx:if="{{item.inventoryMatched}}" class="candidate-match">库存匹配</text>
        </view>
      </scroll-view>
      <view wx:else class="hint">没有识别候选，请对照照片填写。</view>
      <view class="label">确认胎号</view>
      <input class="field" value="{{candidateDraft}}" maxlength="128" placeholder="请输入完整胎号" bindinput="onCandidateDraft" />
      <view wx:if="{{candidateError}}" class="candidate-error">{{candidateError}}</view>
      <view class="candidate-actions">
        <button class="secondary" bindtap="closeCandidatePicker">取消</button>
        <button class="primary" bindtap="confirmCandidate">加入列表</button>
      </view>
    </view>
  </view>
</view>
