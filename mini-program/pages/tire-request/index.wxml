<view class="tire-page">
  <view class="tire-heading">换胎申请</view>
  <view class="tire-sub">{{driver.name || '当前司机'}} · {{driver.currentPlateNo || '未绑定车辆'}}</view>
  <feedback-state wx:if="{{error && !canRequest}}" kind="error" message="{{error}}" bind:retry="load" />
  <block wx:if="{{canRequest}}">
    <view class="tire-step">{{step === 1 ? '1 拍摄轮胎原图' : step === 2 ? '2 识别胎号' : step === 3 ? '3 确认胎号' : step === 4 ? '4 匹配库存' : '5 确认申请'}}</view>
    <view wx:if="{{step === 1}}" class="tire-card">
      <view class="tire-title">拍清楚轮胎上的胎号</view>
      <view class="tire-hint">请让胎号标签完整入镜，避免反光。</view>
      <image wx:if="{{imagePath}}" class="tire-photo" src="{{imagePath}}" mode="aspectFit" />
      <button class="tire-secondary" bindtap="chooseImage">{{imagePath ? '重新选择照片' : '拍照或选择照片'}}</button>
      <view wx:if="{{uploadStatus}}" class="tire-hint">{{uploadStatus}}{{uploadProgress !== null && uploadStatus === '图片上传中' ? ' · ' + uploadProgress + '%' : ''}}</view>
      <view wx:if="{{mediaError}}" class="tire-error">{{mediaError}}</view>
      <button wx:if="{{imagePath}}" class="tire-primary" loading="{{working}}" disabled="{{working}}" bindtap="recognize">上传并识别胎号</button>
    </view>
    <view wx:if="{{step === 2}}" class="tire-card">
      <view class="tire-title">正在处理照片</view>
      <view class="tire-hint">{{uploadStatus}}</view>
      <view wx:if="{{ocrError || mediaError}}" class="tire-error">{{ocrError || mediaError}}</view>
      <button wx:if="{{!working}}" class="tire-primary" bindtap="recognize">重试识别</button>
    </view>
    <view wx:if="{{step === 3}}" class="tire-card">
      <view class="tire-title">确认照片上的胎号</view>
      <view class="tire-hint">请以实物标签为准，识别错误可手工修改。</view>
      <view wx:for="{{ocrCandidates}}" wx:key="candidate" class="tire-candidate" data-index="{{index}}" bindtap="chooseCandidate">
        <text>{{item.candidate}}</text><text>{{item.inventoryMatched ? '可能匹配库存' : '请核对实物'}}</text>
      </view>
      <text class="tire-label">最终确认胎号</text>
      <input class="tire-input" value="{{confirmedTireNo}}" bindinput="onTireNo" placeholder="请输入完整胎号" />
      <view wx:if="{{ocrError}}" class="tire-hint">{{ocrError}}</view>
      <button class="tire-primary" loading="{{working}}" disabled="{{working}}" bindtap="confirmOcr">确认胎号并匹配库存</button>
    </view>
    <view wx:if="{{step === 4}}" class="tire-card">
      <view class="tire-title">正在核对库存轮胎</view>
      <view class="tire-hint">已确认胎号：{{confirmedTireNo}}</view>
      <view class="tire-error">{{matchStatus}}</view>
      <button wx:if="{{!working}}" class="tire-primary" bindtap="retryMatch">重新核对</button>
      <button wx:if="{{!working}}" class="tire-secondary" bindtap="backToPhoto">重新拍照</button>
    </view>
    <view wx:if="{{step === 5}}" class="tire-card">
      <view class="tire-title">确认换胎申请</view>
      <view class="tire-summary"><text>司机</text><text>{{driver.name}}</text></view>
      <view class="tire-summary"><text>当前车辆</text><text>{{driver.currentPlateNo}}</text></view>
      <view class="tire-summary"><text>确认胎号</text><text>{{confirmedTireNo}}</text></view>
      <view class="tire-summary"><text>库存匹配</text><text>可申请</text></view>
      <view class="tire-summary"><text>原图</text><text>已保存</text></view>
      <image wx:if="{{imagePath}}" class="tire-photo" src="{{imagePath}}" mode="aspectFit" />
      <view wx:for="{{items}}" wx:key="tireId" class="tire-hint">另含已确认轮胎 {{item.confirmedTireNo}}</view>
      <view class="tire-hint">提交时系统会再次校验库存状态；若已被其他申请预留，会提示重新处理。</view>
      <view wx:if="{{error}}" class="tire-error">{{error}}</view>
      <button class="tire-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">确认提交申请</button>
      <button class="tire-secondary" bindtap="addItem">继续添加一条轮胎</button>
    </view>
  </block>
</view>
