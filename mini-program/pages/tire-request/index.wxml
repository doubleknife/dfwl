<view class="page">
  <view class="panel">
    <view class="title">换胎申请</view>
    <view class="field">
      <text class="label">车辆 ID</text>
      <input value="{{vehicleId}}" bindinput="onVehicle" type="number" />
    </view>
    <view class="field">
      <text class="label">库存轮胎</text>
      <picker mode="selector" range="{{tires}}" range-key="tireNo" bindchange="onTire">
        <view class="picker-box">{{confirmedTireNo || '选择可用轮胎'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">确认胎号</text>
      <input value="{{confirmedTireNo}}" bindinput="onTireNo" />
    </view>
    <view wx:if="{{ocrCandidates.length}}" class="field">
      <text class="label">识别候选</text>
      <view wx:for="{{ocrCandidates}}" wx:key="candidate" class="row">
        <text>{{item.candidate}}</text>
        <text class="muted">{{item.inventoryMatched ? '库存匹配' : '未匹配'}} · {{item.confidence || '-'}}</text>
        <button size="mini" data-index="{{index}}" bindtap="chooseCandidate">选择</button>
      </view>
    </view>
    <view wx:if="{{ocrError}}" class="muted">{{ocrError}}</view>
    <view class="field">
      <button bindtap="chooseImage">拍摄 / 选择图片</button>
      <view class="muted">{{uploadStatus || imagePath}}</view>
    </view>
    <button bindtap="uploadImage">上传原图</button>
    <button bindtap="recognize">OCR 识别</button>
    <button bindtap="confirmOcr">确认胎号</button>
    <button bindtap="addItem">添加轮胎</button>
  </view>
  <view class="panel">
    <view class="title">本次申请</view>
    <view wx:for="{{items}}" wx:key="tireId" class="row">
      <text>{{item.confirmedTireNo}}</text>
      <text class="tag">轮胎 {{item.tireId}}</text>
    </view>
    <button class="primary" loading="{{loading}}" bindtap="submit">提交申请</button>
  </view>
</view>
