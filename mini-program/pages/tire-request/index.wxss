.tire-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(70rpx + env(safe-area-inset-bottom)); background: var(--mp-page); color: var(--mp-text); }
.title { font-size: 40rpx; font-weight: 700; }
.intro,.hint { color: var(--mp-text-secondary); font-size: 27rpx; line-height: 1.6; }
.steps { margin: 26rpx 0; padding: 18rpx 22rpx; border-radius: 16rpx; background: #e6f3ef; color: #1a6f63; font-size: 27rpx; font-weight: 600; }
.card { margin: 20rpx 0; padding: 26rpx; border: 1rpx solid #dce9e5; border-radius: 22rpx; background: #fff; }
.heading { margin-bottom: 18rpx; font-size: 33rpx; font-weight: 700; }
.label { margin: 24rpx 0 8rpx; font-size: 28rpx; font-weight: 600; }
.field,.readonly { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 20rpx; border: 1rpx solid #d6e4e0; border-radius: 12rpx; font-size: 30rpx; }
.readonly { background: #f5f8f7; }
.photo { width: 220rpx; height: 220rpx; margin: 20rpx 0; border-radius: 14rpx; }
button { margin-top: 24rpx; min-height: 88rpx; line-height: 88rpx; font-size: 30rpx; }
.primary { background: var(--mp-button-primary); color: white; }
.link { display: block; margin-top: 24rpx; padding: 22rpx; text-align: center; }
.feedback { margin: 20rpx 0; padding: 20rpx; border-radius: 12rpx; background: #e8f2ef; }
.error { background: #fff1ed; color: #ad4134; }
.candidate-overlay { position: fixed; z-index: 100; inset: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; background: rgba(18, 45, 40, .48); }
.candidate-dialog { width: 100%; max-height: 85vh; box-sizing: border-box; overflow-y: auto; padding: 32rpx; border-radius: 22rpx; background: #fff; }
.candidate-list { max-height: 380rpx; margin-top: 20rpx; border: 1rpx solid #d6e4e0; border-radius: 12rpx; }
.candidate-option { display: flex; justify-content: space-between; align-items: center; min-height: 86rpx; box-sizing: border-box; padding: 16rpx 20rpx; border-bottom: 1rpx solid #e5eeeb; font-size: 30rpx; }
.candidate-option:last-child { border-bottom: none; }
.candidate-option.selected { background: #e7f3f0; color: #146c60; font-weight: 700; }
.candidate-match { margin-left: 16rpx; color: #14796b; font-size: 24rpx; white-space: nowrap; }
.candidate-error { margin-top: 12rpx; color: #ad4134; font-size: 26rpx; }
.candidate-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 26rpx; }
.candidate-actions button { min-width: 150rpx; margin: 0; }
.tire-item { margin: 24rpx 0; padding: 20rpx; border: 1rpx solid #dce9e5; border-radius: 14rpx; }
.item-title { font-size: 29rpx; font-weight: 700; }
.item-title text { margin-left: 18rpx; font-size: 25rpx; font-weight: 400; }
.item-actions { display: flex; gap: 12rpx; }
.item-actions button { flex: 1; }
.valid { color: #14796b; }
.invalid { color: #ad4134; }
.footer-actions { display: flex; gap: 16rpx; }
.footer-actions button { flex: 1; }
