@import "../../design/tokens.wxss";
.tire-page { min-height: 100vh; background: #f4f8f7; padding: 28rpx 28rpx 80rpx; color: #173b36; }
.tire-heading { font-size: 38rpx; font-weight: 700; margin: 8rpx 0; }
.tire-sub { font-size: 27rpx; color: #59736b; margin-bottom: 28rpx; }
.tire-step { font-size: 27rpx; color: #167768; margin-bottom: 18rpx; font-weight: 650; }
.tire-card { background: #fff; border-radius: 24rpx; padding: 32rpx; }
.tire-title { font-size: 33rpx; font-weight: 700; margin-bottom: 18rpx; }
.tire-hint { font-size: 27rpx; color: #506e66; margin: 16rpx 0; }
.tire-photo { width: 100%; height: 360rpx; border-radius: 18rpx; background: #edf4f1; margin: 20rpx 0; }
.tire-primary, .tire-secondary { min-height: 94rpx; font-size: 30rpx; border-radius: 18rpx; margin-top: 20rpx; }
.tire-primary { background: #147569; color: #fff; }
.tire-secondary { background: #e5f3ee; color: #126e61; }
.tire-candidate { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid #e5efeb; font-size: 32rpx; font-weight: 650; }
.tire-candidate text:last-child { font-size: 24rpx; color: #648078; font-weight: 400; }
.tire-label { display: block; font-size: 27rpx; font-weight: 650; margin: 30rpx 0 12rpx; }
.tire-input { min-height: 88rpx; border-radius: 14rpx; background: #f4f8f7; padding: 0 20rpx; font-size: 32rpx; }
.tire-error { background: #fff1ed; color: #a04436; font-size: 26rpx; padding: 18rpx; border-radius: 14rpx; margin-top: 16rpx; }
.tire-summary { display: flex; justify-content: space-between; gap: 18rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e6efeb; font-size: 29rpx; }
.tire-summary text:first-child { color: #617973; }
