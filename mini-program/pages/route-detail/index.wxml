<view class="mp-route-detail">
  <feedback-state wx:if="{{error}}" kind="error" message="{{error}}" bind:retry="load" />
  <feedback-state wx:if="{{loading && !route}}" kind="loading" message="正在加载线路…" />
  <block wx:if="{{route}}">
    <view class="mp-route-hero"><view class="mp-route-top"><text class="mp-route-number">{{route.routeNo}}</text><status-tag label="{{route.statusLabel}}" tone="{{route.tone}}" /></view><view class="mp-route-places">{{route.loadingPlace || '装货地'}} <text>→</text> {{route.unloadingPlace || '卸货地'}}</view><view class="mp-route-date">{{route.businessDate}}</view></view>
    <view class="mp-route-next"><view class="mp-route-section-title">下一步</view><view class="mp-route-next-copy">{{route.nextAction}}</view></view>
    <view class="mp-route-card"><view class="mp-route-section-title">运输信息</view><view class="mp-route-fact"><text>{{route.status === 'TRANSFER_PENDING' ? '接手司机' : '司机'}}</text><text>{{driverLabel}}</text></view><view class="mp-route-fact"><text>车辆</text><text>{{vehicleLabel}}</text></view><view class="mp-route-fact"><text>发车时间</text><text>{{route.departureLabel}}</text></view><view class="mp-route-fact"><text>卸货时间</text><text>{{route.unloadLabel}}</text></view></view>
    <view wx:if="{{route && route.status === 'COMPLETED'}}" class="mp-route-card"><view class="mp-route-section-title">运输结果</view><view class="mp-route-fact"><text>毛重</text><text>{{route.grossWeight || '—'}} 吨</text></view><view class="mp-route-fact"><text>皮重</text><text>{{route.tareWeight || '—'}} 吨</text></view><view class="mp-route-fact"><text>实际载重</text><text class="mp-route-weight">{{route.netWeight || '—'}} 吨</text></view><button class="mp-route-evidence-link mp-detail-button" bindtap="viewTicket">查看原始卸货磅单 ›</button></view>
  </block>
  <view wx:if="{{route && (route.status === 'PUBLISHED' || route.status === 'TRANSFER_PENDING') && canDepart}}" class="mp-route-bottom"><button class="mp-route-primary primary" loading="{{busy}}" disabled="{{busy || confirming || loading || error}}" bindtap="depart">{{busy ? '正在发车…' : '确认发车'}}</button></view>
  <view wx:elif="{{route && route.status === 'IN_TRANSIT' && canUnload}}" class="mp-route-bottom"><button class="mp-route-primary primary" disabled="{{busy || loading || error}}" bindtap="weight">录入重量并卸货</button></view>
  <view wx:elif="{{route && (route.status === 'PUBLISHED' || route.status === 'TRANSFER_PENDING' || route.status === 'IN_TRANSIT') && !loading}}" class="mp-route-permission">当前账号不是该线路的执行司机，或没有下一步操作权限，请联系调度。</view>
</view>
