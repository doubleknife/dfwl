.dispatch-page{padding:24rpx;color:#183d35}.title{font-size:38rpx;font-weight:700;margin-bottom:20rpx}.card{background:#fff;border-radius:20rpx;padding:24rpx}.tabs,.actions{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.tabs{border-bottom:1rpx solid #dce7e2;padding-bottom:16rpx;margin-bottom:20rpx}.tabs button,.actions button{flex:1;min-width:180rpx;margin:0}.tabs .active{background:#185d4d;color:#fff}.label{margin:24rpx 0 10rpx;font-weight:600}.field{box-sizing:border-box;width:100%;min-height:80rpx;background:#f6f9f7;border:1rpx solid #cedfd5;border-radius:10rpx;padding:16rpx}.reason{height:160rpx}.hint{color:#65786e;font-size:25rpx;margin:16rpx 0}.feedback{padding:20rpx;margin-bottom:16rpx;border-radius:12rpx;background:#eef5f1;word-break:break-all}.error{color:#a72a2a;background:#fff0ee}.success{color:#185d4d}.primary{background:#185d4d;color:white;margin-top:24rpx}.secondary{background:#f4f8f5;color:#185d4d;margin-top:16rpx}.task{padding:24rpx 12rpx;border-bottom:1rpx solid #e0e8e3;line-height:1.8;word-break:break-all}.heading{font-weight:700}.highlight{border:2rpx solid #277c60;background:#eff9f4;border-radius:12rpx}.action-panel{border-top:4rpx solid #185d4d;padding-top:24rpx;margin-top:24rpx}.actions{margin-top:20rpx;font-size:24rpx}

.detail-row{display:flex;justify-content:space-between;gap:24rpx;padding:20rpx 0;border-bottom:1rpx solid #edf2ef;word-break:break-all}.detail-label{flex-shrink:0;color:#65786e}.detail-row>text:last-child{text-align:right}
