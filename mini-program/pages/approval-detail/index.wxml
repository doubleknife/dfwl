<view class="approval-detail-page">
  <feedback-state wx:if="{{error && !detail}}" kind="error" message="{{error}}" bind:retry="load" />
  <block wx:if="{{detail}}">
    <view class="detail-card">
      <view class="detail-title">{{detail.approval.flowName || detail.approval.typeLabel}}</view>
      <view class="detail-status">{{detail.approval.statusLabel}}</view>
      <view class="detail-sub">申请时间 {{detail.approval.createdAt}}</view>
      <view class="detail-sub">当前节点 {{detail.approval.currentNodeName || '流程已结束'}}</view>
    </view>
    <view class="detail-section-heading">申请依据</view>
    <view wx:for="{{detail.submissions}}" wx:key="id" class="detail-card">
      <view class="detail-version">第 {{item.versionNo}} 次提交（V{{item.versionNo}}） <text>{{item.submittedAt}}</text></view>
      <view wx:for="{{item.facts}}" wx:for-item="fact" wx:key="label" class="detail-fact">
        <text>{{fact.label}}</text><text>{{fact.value}}</text>
      </view>
      <view class="detail-evidence-title">申请图片</view>
      <view wx:for="{{item.attachments}}" wx:for-item="file" wx:key="id" class="detail-file" data-id="{{file.id}}" bindtap="previewFile">查看 {{file.originalFilename || '申请图片'}} ›</view>
      <view wx:if="{{item.attachments.length === 0}}" class="detail-sub">此版本没有申请图片</view>
    </view>
    <view class="detail-section-heading">审批时间线</view>
    <view wx:for="{{detail.tasks}}" wx:key="id" class="detail-card detail-timeline">
      <view class="detail-version">第 {{item.submissionVersionNo}} 次提交 · {{item.nodeName}}</view>
      <view class="detail-sub">{{item.statusLabel}} · {{item.createdAt}}{{item.invalidated ? ' · 历史节点' : ''}}</view>
      <view wx:for="{{item.actions}}" wx:for-item="action" wx:key="id" class="detail-action">
        <view class="detail-action-title">{{action.actionLabel}} · {{action.operatedAt}}</view>
        <view wx:if="{{action.comment}}" class="detail-sub">意见：{{action.comment}}</view>
        <view wx:for="{{action.attachments}}" wx:for-item="file" wx:key="id" class="detail-file" data-id="{{file.id}}" bindtap="previewFile">查看审批补充图片 ›</view>
      </view>
    </view>
    <view wx:if="{{canApprove || canReturn}}" class="detail-card">
      <view class="detail-section-heading">处理申请</view>
      <view class="detail-field"><text>审批意见</text><textarea value="{{comment}}" bindinput="onComment" placeholder="请填写处理意见" /></view>
      <button class="detail-secondary" bindtap="chooseImage">选择补充图片</button>
      <view wx:if="{{uploadStatus}}" class="detail-sub">{{uploadStatus}}</view>
      <button wx:if="{{canApprove}}" class="detail-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="approve">确认通过</button>
      <button wx:if="{{canReturn}}" class="detail-secondary" disabled="{{loading}}" bindtap="returnApplicant">打回申请人修改</button>
      <picker wx:if="{{canReturn && returnNodes.length}}" mode="selector" range="{{returnNodes}}" range-key="nodeName" bindchange="onTarget">
        <view class="detail-picker">{{selectedNodeName || '选择打回节点'}} ›</view>
      </picker>
      <button wx:if="{{canReturn && returnNodes.length}}" class="detail-secondary" disabled="{{loading || !targetNodeOrder}}" bindtap="returnNode">打回所选节点</button>
    </view>
    <feedback-state wx:if="{{error}}" kind="error" message="{{error}}" bind:retry="load" />
  </block>
</view>
