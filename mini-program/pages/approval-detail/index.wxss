@import "../../design/tokens.wxss";
.approval-detail-page { min-height: 100vh; background: #f4f8f7; padding: 28rpx; color: #173b36; }
.detail-card { background: #fff; border-radius: 22rpx; padding: 30rpx; margin-bottom: 20rpx; }
.detail-title { font-size: 38rpx; font-weight: 700; }
.detail-status { display: inline-block; background: #e4f3ed; color: #126e60; border-radius: 10rpx; padding: 7rpx 16rpx; font-size: 25rpx; margin: 18rpx 0; }
.detail-sub { font-size: 26rpx; color: #526f68; margin-top: 10rpx; }
.detail-section-heading { font-size: 32rpx; font-weight: 700; margin: 24rpx 0 18rpx; }
.detail-version { font-size: 29rpx; font-weight: 700; display: flex; justify-content: space-between; }
.detail-version text { font-size: 24rpx; font-weight: 400; color: #637a74; }
.detail-fact { display: flex; justify-content: space-between; gap: 18rpx; padding: 17rpx 0; border-bottom: 1rpx solid #ebf0ee; font-size: 27rpx; }
.detail-fact text:first-child { color: #627973; }
.detail-fact text:last-child { text-align: right; }
.detail-evidence-title { font-size: 27rpx; font-weight: 650; margin-top: 20rpx; }
.detail-file, .detail-picker { min-height: 88rpx; display: flex; align-items: center; padding: 0 18rpx; margin-top: 12rpx; border-radius: 14rpx; background: #e8f4f0; color: #126f62; font-size: 28rpx; }
.detail-timeline { border-left: 5rpx solid #69a99c; }
.detail-action { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #e8efec; }
.detail-action-title { font-size: 27rpx; font-weight: 650; }
.detail-field text { display: block; font-size: 27rpx; font-weight: 650; margin: 18rpx 0 10rpx; }
.detail-field textarea { width: 100%; box-sizing: border-box; min-height: 140rpx; padding: 18rpx; border: 1rpx solid #d8e6e1; border-radius: 14rpx; }
.detail-primary, .detail-secondary { min-height: 88rpx; margin-top: 16rpx; border-radius: 16rpx; font-size: 29rpx; }
.detail-primary { background: #157569; color: #fff; }
.detail-secondary { background: #e8f4f0; color: #126f62; }
