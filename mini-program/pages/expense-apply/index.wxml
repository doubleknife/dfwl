<view class="expense-page">
  <view class="expense-heading">发起费用审批</view>
  <view class="expense-progress">第 {{step}} 步 / 共 5 步</view>
  <view wx:if="{{error}}" class="expense-error">{{error}}</view>

  <view wx:if="{{step === 1}}" class="expense-card">
    <view class="expense-title">选择申请类型</view>
    <view class="expense-hint">请选择符合本次业务的费用模板</view>
    <picker mode="selector" range="{{templates}}" range-key="flowName" bindchange="chooseTemplate">
      <view class="expense-picker">{{template.flowName || '请选择费用申请类型'}} ›</view>
    </picker>
    <view wx:if="{{launchReason}}" class="expense-hint">{{launchReason}}</view>
  </view>

  <view wx:if="{{step === 2}}" class="expense-card">
    <view class="expense-title">选择费用归属</view>
    <text class="expense-label">归属类型</text>
    <picker wx:if="{{attributionTypes.length > 1}}" mode="selector" range="{{attributionOptions}}" range-key="label" bindchange="chooseAttribution">
      <view class="expense-picker">{{attributionType === 'ROUTE' ? '线路费用' : attributionType === 'DAILY' ? '日常费用' : '请选择费用归属'}} ›</view>
    </picker>
    <view wx:else class="expense-picker">{{attributionType === 'ROUTE' ? '线路费用' : '日常费用'}}</view>
    <view wx:if="{{attributionType === 'ROUTE'}}">
      <text class="expense-label">关联线路</text>
      <picker mode="selector" range="{{routes}}" range-key="routeNo" bindchange="chooseRoute">
        <view class="expense-picker">{{selectedRouteNo || '请选择线路'}} ›</view>
      </picker>
      <view wx:if="{{routes.length === 0}}" class="expense-hint">当前没有可选择的线路</view>
    </view>
  </view>

  <view wx:if="{{step === 3}}" class="expense-card">
    <view class="expense-title">填写费用明细</view>
    <view wx:for="{{items}}" wx:for-item="entry" wx:key="itemNo" class="expense-item">
      <view class="expense-item-head"><text>明细 {{index + 1}}</text><text class="expense-remove" data-index="{{index}}" bindtap="removeItem">移除</text></view>
      <text class="expense-label">车辆</text>
      <view wx:if="{{user.driverId}}" class="expense-picker">{{user.currentPlateNo || '当前未绑定车辆'}}</view>
      <picker wx:else mode="selector" range="{{vehicles}}" range-key="plateNo" data-index="{{index}}" bindchange="chooseVehicle"><view class="expense-picker">{{entry.vehicleName || '请选择车辆'}} ›</view></picker>
      <text class="expense-label">司机</text>
      <view wx:if="{{user.driverId}}" class="expense-picker">{{user.driverName}}</view>
      <picker wx:else mode="selector" range="{{drivers}}" range-key="name" data-index="{{index}}" bindchange="chooseDriver"><view class="expense-picker">{{entry.driverName || '可选司机'}} ›</view></picker>
      <text class="expense-label">金额（元）</text>
      <input class="expense-input" type="digit" value="{{entry.amount}}" data-index="{{index}}" data-field="amount" bindinput="setItemField" placeholder="例如 125.50" />
      <text class="expense-label">业务日期</text>
      <picker mode="date" data-index="{{index}}" data-field="businessDate" bindchange="setItemField"><view class="expense-picker">{{entry.businessDate || '请选择业务日期'}} ›</view></picker>
      <text class="expense-label">说明</text>
      <textarea class="expense-input expense-textarea" value="{{entry.remark}}" data-index="{{index}}" data-field="remark" bindinput="setItemField" placeholder="请简要说明费用用途" />
      <block wx:if="{{energyTemplate}}">
        <text class="expense-label">能源订单号</text><input class="expense-input" value="{{entry.orderNo}}" data-index="{{index}}" data-field="orderNo" bindinput="setItemField" />
        <text class="expense-label">能源开始日期</text><picker mode="date" data-index="{{index}}" bindchange="chooseEnergyDate"><view class="expense-picker">{{entry.startDate || '请选择日期'}} ›</view></picker>
        <text class="expense-label">能源开始时间</text><picker mode="time" data-index="{{index}}" bindchange="chooseEnergyTime"><view class="expense-picker">{{entry.startClock || '请选择时间'}} ›</view></picker>
        <text class="expense-label">能源数量</text><input class="expense-input" type="digit" value="{{entry.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="setItemField" />
      </block>
    </view>
    <button class="expense-secondary" bindtap="addItem">添加一条明细</button>
  </view>

  <view wx:if="{{step === 4}}" class="expense-card">
    <view class="expense-title">上传申请依据</view>
    <view class="expense-hint">{{template.evidenceRequirement === 'REQUIRED' ? '此申请必须上传图片' : template.evidenceRequirement === 'OPTIONAL' ? '可以上传图片帮助审批人理解' : '此申请无需图片'}}</view>
    <block wx:if="{{template.evidenceRequirement !== 'NONE'}}">
      <button class="expense-secondary" bindtap="chooseImage">拍照或选择图片</button>
      <view wx:if="{{uploadStatus}}" class="expense-hint">{{uploadStatus}}</view>
      <button wx:if="{{imagePath}}" class="expense-secondary" loading="{{uploading}}" disabled="{{uploading}}" bindtap="uploadEvidence">上传所选图片</button>
      <view wx:for="{{evidence}}" wx:for-item="file" wx:key="id" class="expense-evidence">{{file.originalFilename || '申请图片'}} <text data-index="{{index}}" bindtap="removeEvidence">移除</text></view>
    </block>
  </view>

  <view wx:if="{{step === 5}}" class="expense-card">
    <view class="expense-title">确认申请</view>
    <view class="expense-summary"><text>申请类型</text><text>{{summary.templateName}}</text></view>
    <view class="expense-summary"><text>费用归属</text><text>{{summary.attribution}}</text></view>
    <view wx:if="{{summary.routeNo}}" class="expense-summary"><text>关联线路</text><text>{{summary.routeNo}}</text></view>
    <view class="expense-summary"><text>明细数量</text><text>{{summary.itemCount}} 条</text></view>
    <view class="expense-summary"><text>金额合计</text><text>¥ {{summary.amount}}</text></view>
    <view class="expense-summary"><text>依据图片</text><text>{{summary.imageCount}} 张</text></view>
    <view class="expense-hint">确认无误后提交，审批人会看到这些申请事实。</view>
  </view>

  <view class="expense-actions">
    <button wx:if="{{step > 1}}" class="expense-secondary" bindtap="previousStep">上一步</button>
    <button wx:if="{{step < 5}}" class="expense-primary" bindtap="nextStep">下一步</button>
    <button wx:else class="expense-primary" loading="{{loading}}" disabled="{{loading || uploading}}" bindtap="submit">确认提交</button>
  </view>
</view>
