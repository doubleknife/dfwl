<view class="expense-page">
  <view class="title">{{resubmitId?'修改费用并重新提交':'发起费用申请'}}</view>
  <view wx:if="{{error}}" class="feedback error">{{error}} <text bindtap="load">重试</text></view>
  <view wx:if="{{loading}}" class="feedback">正在准备费用申请…</view>
  <block wx:if="{{denied}}"><view class="expense-card">当前账号没有费用申请权限。</view></block>
  <block wx:elif="{{step===1}}">
    <view class="expense-card">
      <view class="section-title">1. 选择申请来源</view>
      <view wx:if="{{resubmitId}}" class="hint">申请来源保持原样；修改后会形成新的提交版本。</view>
      <view class="scopes">
        <view class="scope {{scope==='DAILY'?'active':''}}" data-scope="DAILY" bindtap="onScope">日常费用</view>
        <view class="scope {{scope==='TASK'?'active':''}}" data-scope="TASK" bindtap="onScope">任务费用</view>
      </view>
      <view class="hint">{{scope==='DAILY'?'审批通过后先计公司费用，可后续归属任务。':ownDriver?'先选择本人正式参与的任务。':'先选择所选司机正式参与的任务。'}}</view>
      <view class="label">费用大类</view>
      <search-select title="选择费用大类" options="{{templates}}" label-key="name" value-key="id"
        current-value="{{templateIndex>=0?templates[templateIndex].id:''}}"
        display-text="{{templateIndex>=0?templates[templateIndex].name:''}}"
        placeholder="请选择费用大类" disabled="{{!!resubmitId}}" bind:change="onTemplate" />
    </view>
    <view class="expense-card">
      <view class="section-title">2. 填写费用信息</view>
      <view class="label">司机</view>
      <view wx:if="{{ownDriver}}" class="field readonly">{{driverName || '正在读取本人信息'}}</view>
      <search-select wx:else title="选择司机" options="{{drivers}}" label-key="name" value-key="id"
        current-value="{{driverId}}" display-text="{{driverIndex>=0?driverName:''}}"
        placeholder="请选择司机" disabled="{{!!resubmitId}}" bind:change="onDriver" />
      <view wx:if="{{scope==='TASK'}}">
        <view class="label">{{ownDriver?'本人参与的运输任务':'所选司机参与的运输任务'}}</view>
        <search-select title="选择运输任务" options="{{visibleTasks}}" label-key="taskLabel" value-key="taskId" multi-line="{{true}}"
          current-value="{{taskIndex>=0?tasks[taskIndex].taskId:''}}"
          display-text="{{taskIndex>=0?tasks[taskIndex].taskLabel:''}}"
          placeholder="请选择任务" bind:change="onTask" />
        <view wx:if="{{!visibleTasks.length}}" class="hint">暂无符合当前费用大类的参与任务</view>
      </view>
      <view class="label">公司车牌</view>
      <search-select wx:if="{{scope==='DAILY'}}" title="选择公司车辆" options="{{visibleVehicles}}"
        label-key="plateNo" value-key="id" current-value="{{vehicleIndex>=0?vehicles[vehicleIndex].id:''}}"
        display-text="{{vehicleIndex>=0?vehicles[vehicleIndex].plateNo:''}}"
        placeholder="请选择公司车辆" bind:change="onVehicle" />
      <view wx:else class="field readonly">{{vehicleIndex>=0?vehicles[vehicleIndex].plateNo:'先选择参与任务'}}</view>
      <view wx:if="{{scope==='DAILY' && !visibleVehicles.length}}" class="hint">暂无符合当前费用大类的公司车辆</view>
      <view wx:if="{{energyHint}}" class="hint">{{energyHint}}</view>
      <view class="label">业务日期</view>
      <picker mode="date" value="{{businessDate}}" bindchange="onDate"><view class="field">{{businessDate}}</view></picker>
      <view class="label">金额（元）</view>
      <input class="field" type="digit" value="{{amount}}" data-field="amount" bindinput="onField" placeholder="请输入大于 0 的金额" />
      <view class="label">明细（选填）</view>
      <input class="field" value="{{description}}" data-field="description" bindinput="onField" placeholder="例如：维修项目" />
      <view class="label">票据号（选填）</view>
      <input class="field" value="{{receiptNo}}" data-field="receiptNo" bindinput="onField" />
      <view class="label">发票号（选填）</view>
      <input class="field" value="{{invoiceNo}}" data-field="invoiceNo" bindinput="onField" />
      <view class="label">站点名称（选填）</view>
      <input class="field" value="{{stationName}}" data-field="stationName" bindinput="onField" />
      <view class="label">备注（选填）</view>
      <input class="field" value="{{remark}}" data-field="remark" bindinput="onField" />
      <view class="section-title">图片凭证（选填）</view>
      <button class="secondary" disabled="{{uploading || busy}}" bindtap="addImages">{{uploading?'上传中…':'拍照或从相册选择'}}</button>
      <view class="expense-image-grid">
        <view wx:for="{{images}}" wx:key="id" class="expense-image-item">
          <image src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
          <text data-index="{{index}}" bindtap="removeImage">移除</text>
        </view>
      </view>
    </view>
    <button class="primary" disabled="{{uploading}}" bindtap="review">核对申请摘要</button>
  </block>
  <block wx:elif="{{step===2}}">
    <view class="expense-card">
      <view class="section-title">3. 提交前核对</view>
      <view class="summary-row">申请来源 <text>{{scope==='DAILY'?'日常费用':'任务费用'}}</text></view>
      <view class="summary-row">费用大类 <text>{{templates[templateIndex].name}}</text></view>
      <view class="summary-row">司机 <text>{{driverName}}</text></view>
      <view class="summary-row">公司车牌 <text>{{vehicles[vehicleIndex].plateNo}}</text></view>
      <view wx:if="{{scope==='TASK'}}" class="summary-row">运输任务 <text>{{tasks[taskIndex].taskLabel}}</text></view>
      <view class="summary-row">业务日期 <text>{{businessDate}}</text></view>
      <view class="summary-row amount">金额 <text>¥{{amount}}</text></view>
      <view class="summary-row">图片凭证 <text>{{images.length}} 张</text></view>
      <view wx:if="{{description}}" class="hint">明细：{{description}}</view>
    </view>
    <button class="secondary" disabled="{{busy}}" bindtap="edit">返回修改</button>
    <button class="primary" disabled="{{busy || uploading}}" bindtap="submit">{{busy?'提交中…':'确认提交审批'}}</button>
  </block>
  <view wx:else class="expense-card">
    <view class="section-title">申请已提交</view>
    <view class="hint">审批编号：{{submittedNo}}</view>
    <button class="mp-detail-button" bindtap="openApprovals">查看我的申请 ›</button>
  </view>
</view>
