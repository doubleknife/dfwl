.summary { display: flex; align-items: center; gap: 16rpx; min-height: 112rpx; padding: 12rpx 4rpx; }
.summary-main { display: flex; align-items: center; gap: 22rpx; min-height: 100rpx; flex: 1; min-width: 0; }
.avatar { width: 82rpx; height: 82rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e1f1eb; color: #176f62; font-size: 34rpx; font-weight: 700; }
.copy { flex: 1; min-width: 0; }
.name { font-size: 38rpx; line-height: 1.3; color: #18332e; font-weight: 700; }
.subtitle { margin-top: 4rpx; font-size: 27rpx; color: #526d65; }
.notice { position: relative; display: flex; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--mp-surface); }
.notice-icon { font-size: 42rpx; color: var(--mp-primary); line-height: 1; }
.notice-count { position: absolute; right: -2rpx; top: -7rpx; min-width: 30rpx; height: 30rpx; padding: 0 4rpx; box-sizing: border-box; border-radius: 16rpx; background: var(--mp-danger); color: #fff; text-align: center; line-height: 30rpx; font-size: 20rpx; font-weight: 700; }
