@import "design/tokens.wxss";

page {
  background: #f4f6f8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
.page {
  padding: 24rpx;
}
.panel {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.06);
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
}
.muted {
  color: #6b7280;
  font-size: 24rpx;
}
.tag {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f3f1;
  color: #0f6b5f;
  font-size: 22rpx;
}
.field {
  margin: 18rpx 0;
}
.label {
  display: block;
  color: #4b5563;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
input,
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e0e8;
  border-radius: 6rpx;
}
textarea {
  padding-top: 16rpx;
}
button {
  box-sizing: border-box;
  min-height: var(--mp-button-height);
  border-radius: var(--mp-button-radius);
  font-size: 30rpx;
}
button.primary, navigator.primary {
  background: var(--mp-button-primary);
  color: #fff;
}
button.primary:active, navigator.primary:active { background: var(--mp-button-primary-pressed); }
button.secondary, button.mp-secondary { border: 1rpx solid var(--mp-button-border); background: #fff; color: var(--mp-button-text); }
button.mp-danger { border: 1rpx solid var(--mp-danger); background: #fff; color: var(--mp-danger); }
button[disabled] { opacity: .52; }
.mp-detail-link { min-height: 72rpx; display: flex; align-items: center; justify-content: flex-end; color: var(--mp-primary); font-size: 28rpx; font-weight: 600; }
button.mp-detail-button, navigator.mp-detail-button { box-sizing: border-box; min-height: var(--mp-button-height); border: 1rpx solid var(--mp-button-border); border-radius: var(--mp-button-radius); background: #fff; color: var(--mp-primary); font-size: 29rpx; font-weight: 600; }
button.mp-detail-button:active, navigator.mp-detail-button:active { background: var(--mp-primary-soft); }
button.mp-return-button { min-height: var(--mp-button-height); border: 0; background: transparent; color: var(--mp-primary); font-size: 28rpx; font-weight: 600; }
button.mp-detail-button::after, button.mp-return-button::after { border: 0; }
button.primary::after, button.secondary::after, button.mp-danger::after { border: 0; }
button.mp-return-button:active { background: var(--mp-primary-soft); }
.grid-menu {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}
.menu-card,
.picker-box,
.timeline {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.06);
}
.menu-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.picker-box {
  background: #f8fafc;
  border: 1rpx solid #d9e0e8;
  margin-bottom: 0;
}
.tabs {
  display: flex;
  gap: 12rpx;
}
.tabs button {
  flex: 1;
}
.radio-row {
  display: flex;
  gap: 28rpx;
  margin: 18rpx 0;
}
.json-text {
  margin-top: 8rpx;
  padding: 16rpx;
  border-radius: 6rpx;
  background: #f8fafc;
  color: #4b5563;
  font-size: 22rpx;
  word-break: break-all;
}
